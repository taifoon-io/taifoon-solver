# Taifoon Solver Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# === Wallet Configuration ===
# EVM private key (0x...)
SOLVER_PRIVATE_KEY=

# Solana keypair path
SOLANA_KEYPAIR_PATH=

# === Network Configuration ===
# Genome stream URL
GENOME_SSE_URL=https://api.taifoon.dev/api/genome/subscribe/sse

# Minimum profit threshold in USD
MIN_PROFIT_USD=1.0

# === RPC Endpoints ===
# Add your RPC endpoints here
# ETHEREUM_RPC=
# BASE_RPC=
# ARBITRUM_RPC=
# OPTIMISM_RPC=
# SOLANA_RPC_URL=

# === Optional ===
# Dry run mode (simulate fills, no on-chain broadcast).
# REQUIRED-EXPLICIT semantics (decision 60a19039 / portal-2026):
#   - Unset      => LIVE (false). The solver NEVER silently dry-runs in prod.
#   - true|1|yes|on  => dry-run (simulate only)
#   - false|0|no|off => live fills
#   - any other value (typo) => the solver REFUSES TO START (no silent no-op)
# Set this explicitly in production to make intent unambiguous.
# DRY_RUN=false
